{
  "name": "tatalance",
  "version": "1.0.0",
  "private": true,
  "description": "Tatalance — scripts delegate to backend (Maven) and tests/e2e (Playwright)",
  "scripts": {
    "test:e2e": "npm run test:e2e --prefix tests/e2e",
    "test:e2e:ui": "npm run test:e2e:ui --prefix tests/e2e",
    "test:e2e:headed": "npm run test:e2e:headed --prefix tests/e2e",
    "test:e2e:mobile": "npm run test:e2e:mobile --prefix tests/e2e",
    "report": "npm run report --prefix tests/e2e"
  }
}