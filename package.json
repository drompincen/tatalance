{
  "name": "tatalance-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end + web-quality tests for Tatalance (Playwright + axe-core)",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:mobile": "playwright test --project='Mobile Safari (iPhone SE)'",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0"
  }
}
